{
  "id": "foxSchemaMatchDemo1",
  "name": "Fox Schema Pipe Match - CSV Upsert & Error Handler",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": {
          "mode": "list",
          "value": "pipe_match_users"
        },
        "dataSource": "csv",
        "csvInputMode": "textContent",
        "csvText": "id,firstName,email,age,tier\n1,Alice Updated,alice@example.com,31,enterprise\n2,Bob Builder,bob@example.com,27,pro\n3,Bad Age,bad@example.com,not_a_number,free\n4,Negative Age,neg@example.com,-5,free",
        "csvDelimiter": ",",
        "hasHeader": true,
        "mappingMode": "auto",
        "matchRule": "normalized",
        "unmatchedSourceBehavior": "ignore",
        "errorHandlerMode": "routeToErrorOutput",
        "errorHandlerOptions": {
          "isolateFailedBatchRows": true,
          "strictTypeValidation": true
        },
        "outputMode": "summaryWithRows"
      },
      "id": "fox-match-1",
      "name": "Fox Schema Match",
      "type": "n8n-nodes-fox-schema-match.foxSchemaMatch",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "foxSchemaMatchDbApi": {
          "id": "foxPgCred1",
          "name": "FoxSchema Postgres (demo_a)"
        }
      }
    },
    {
      "parameters": {},
      "id": "matched-out",
      "name": "Matched Output",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [800, 200]
    },
    {
      "parameters": {},
      "id": "error-out",
      "name": "Error Handler Output",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [800, 400]
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [
        [
          {
            "node": "Fox Schema Match",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fox Schema Match": {
      "main": [
        [
          {
            "node": "Matched Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Handler Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
