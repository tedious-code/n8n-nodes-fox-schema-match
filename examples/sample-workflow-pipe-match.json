{
  "id": "foxSchemaMatchDemo1",
  "name": "Fox Schema Match - Mapped Insert / Upsert with Validation & Regex",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": {
          "mode": "list",
          "value": "pipe_match_users"
        },
        "mappingMode": "resourceMapper",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": 10,
            "first_name": "Elena Vance",
            "email": "elena@foxschema.com",
            "age": 28,
            "tier": "pro"
          },
          "matchingColumns": ["id"],
          "schema": [
            { "id": "id", "displayName": "id", "defaultMatch": true, "canBeUsedToMatch": true, "required": true, "display": true, "type": "number", "removed": false },
            { "id": "first_name", "displayName": "first_name", "defaultMatch": false, "canBeUsedToMatch": true, "required": true, "display": true, "type": "string", "removed": false },
            { "id": "email", "displayName": "email", "defaultMatch": false, "canBeUsedToMatch": true, "required": true, "display": true, "type": "string", "removed": false },
            { "id": "age", "displayName": "age", "defaultMatch": false, "canBeUsedToMatch": true, "required": false, "display": true, "type": "number", "removed": false },
            { "id": "tier", "displayName": "tier", "defaultMatch": false, "canBeUsedToMatch": true, "required": false, "display": true, "type": "string", "removed": false }
          ]
        },
        "columnRules": {
          "ruleValues": [
            {
              "targetColumn": "email",
              "trim": true,
              "caseTransform": "lowercase",
              "regexAction": "validate",
              "regexPattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            },
            {
              "targetColumn": "age",
              "dataType": "integer",
              "minValue": "0"
            }
          ]
        },
        "errorHandlerMode": "routeToErrorOutput",
        "outputMode": "summaryWithRows"
      },
      "id": "fox-match-1",
      "name": "Fox Schema Match",
      "type": "n8n-nodes-fox-schema-match.foxSchemaMatch",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "foxSchemaMatchDbApi": {
          "id": "foxPgCred1",
          "name": "FoxSchema Postgres (demo_a)"
        }
      }
    },
    {
      "parameters": {},
      "id": "matched-out",
      "name": "Matched Output",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [800, 200]
    },
    {
      "parameters": {},
      "id": "error-out",
      "name": "Error Handler Output",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [800, 400]
    }
  ],
  "connections": {
    "When clicking 'Execute workflow'": {
      "main": [
        [
          {
            "node": "Fox Schema Match",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fox Schema Match": {
      "main": [
        [
          {
            "node": "Matched Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Handler Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
